<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script"/>
    </handlers>

    <!-- WORKER COUNT: exactly one, and it must stay one.
         QUOT runs two workers. This app cannot. Each worker is a separate
         process with its own decrypted working set and its own in-memory
         session keys (misc/ARCHITECTURE.md section 5.6). With two, a write
         handled by one worker leaves the other serving stale balances, and a
         user unlocked on one worker is locked on the other. This is a
         correctness constraint, not a capacity one.

         Do not write the flag name in this comment: a literal double hyphen
         is illegal inside an XML comment, and IIS rejects the whole file with
         HTTP 500.19. -->
    <httpPlatform
        processPath="C:\inetpub\wwwroot\FAST-PYTHON\.venv\Scripts\python.exe"
        arguments="-m uvicorn app.main:app --port %HTTP_PLATFORM_PORT% --workers 1 --log-level info --proxy-headers --forwarded-allow-ips=*"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\uvicorn.log"
        startupTimeLimit="120"
        requestTimeout="00:05:00"
        processesPerApplication="1">

        <environmentVariables>
            <environmentVariable name="PYTHONPATH" value="C:\inetpub\wwwroot\ZBDGT" />
            <environmentVariable name="ENVIRONMENT" value="production" />
            <environmentVariable name="DEBUG" value="false" />
            <!-- Every route is mounted under BASE_URL and the API under
                 API_PREFIX. Both carry /ZBDGT so the URLs the app generates
                 match the URLs IIS delivers. The IIS application must be
                 named ZBDGT for the same reason. -->
            <environmentVariable name="BASE_URL" value="/ZBDGT" />
            <environmentVariable name="API_PREFIX" value="/ZBDGT/api/v1" />
            <!-- Production is HTTPS on the same host as QUOT
                 (https://delca.noahapplication.com/ZBDGT), so the session
                 cookie is sent over TLS only. -->
            <environmentVariable name="SESSION_COOKIE_SECURE" value="true" />
            <!-- The origin password-reset emails link to (SEC-30). Never taken
                 from the request's Host header, which the requester controls. -->
            <environmentVariable name="APP_PUBLIC_URL" value="https://delca.noahapplication.com" />
            <!-- NO SECRETS IN THIS FILE. It is committed to git. The master key,
                 blind-index pepper, JWT secret, registration code and database
                 password are read from .env in the application folder at
                 startup. A key written here would be a key in version control. -->
            <!-- Shared FastAPI virtual environment, the same one QUOT uses. -->
            <environmentVariable name="PATH" value="C:\inetpub\wwwroot\FAST-PYTHON\.venv\Scripts;%PATH%" />
        </environmentVariables>
    </httpPlatform>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- No rewrite rule, deliberately, same as QUOT. httpPlatformHandler
         forwards /ZBDGT/... unchanged, which is exactly where the app
         registers its routes. Stripping the prefix would 404 every route. -->

    <!-- IDLE SHUTDOWN, and why this app is built around it.
         After the app-pool idle timeout (20 minutes by default) IIS stops the
         process, and it starts again on the next request. AlwaysRunning and
         Idle Time-out = 0 were declined for QUOT on 2026-09-10 because of
         memory on a server running ~90 applications. This app assumes the
         same and does not ask for them.

         What that means here, all by design:
           - Nothing is scheduled for a time when the process may be stopped.
             Recurring payments, installments and subscription reminders
             catch up at login.
           - Backups happen 5 minutes after the last change, and at login if
             the newest is over a day old - never at a fixed time. IIS keeps
             the process alive for 20 minutes after a request, so the
             5-minute delay always fires first (ARCHITECTURE.md section 12.6).
           - A restart looks exactly like an auto-lock: the in-memory keys are
             gone, so the next request asks for the PIN, then unlocks and
             re-warms. Nobody is logged out. -->
    <applicationInitialization doAppInitAfterRestart="true" skipManagedModules="true">
      <add initializationPage="/ZBDGT/api/v1/health" />
    </applicationInitialization>

    <!-- SECURITY HEADERS ARE SET BY THE APP, NOT HERE.
         QUOT sets them in IIS. This app's middleware sends a per-request
         Content-Security-Policy nonce, X-Frame-Options DENY and nosniff
         (ARCHITECTURE.md section 8). Setting them here as well would send
         each header twice, and QUOT's SAMEORIGIN next to the app's DENY is a
         conflict that browsers resolve inconsistently. One owner.
         No HSTS from either place: it applies to the whole host, and this
         app shares its host with QUOT and the other applications. -->

    <security>
      <requestFiltering>
        <!-- 100 MB, same as QUOT. Sized for restoring a .budgetbak that
             carries receipt photos; ordinary requests are far smaller. -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
