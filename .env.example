# ============================================================
# BUDGET APP - Environment Template
# ============================================================
# Copy to .env and fill in. The real .env is gitignored.
#
#   cp .env.example .env
#
# Generate every secret below in one go:
#
#   python scripts/generate_keys.py
#
# Or by hand:
#
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
#
# NEVER commit a filled-in .env. NEVER reuse keys between installs.
# ============================================================


# ============================================
# Database Configuration
# ============================================
DB_SERVER=localhost
DB_NAME=P8_NOAH_AI
DB_SCHEMA=ZBDGT
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=False
DB_ENCRYPT=True
DB_TRUST_SERVER_CERTIFICATE=True
DB_CONNECTION_TIMEOUT=30
DB_COMMAND_TIMEOUT=60
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800


# ============================================
# APPLICATION-LEVEL ENCRYPTION
# ============================================
# 32 random bytes, base64. Wraps every per-user DEK.
# It is the ONLY key to every account - there is no recovery phrase.
# Keep an offline copy of this whole file, in two places, off the server
# and apart from the backups (misc/how-to-run.txt). Lose .env and every
# copy, and all data of all users is gone.
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
BUDGET_MASTER_KEY=

# Bumped only by scripts/rotate_keys.py.
BUDGET_KEY_VERSION=1

# Retired keys during rotation: "1:base64key,2:base64key"
BUDGET_RETIRED_KEYS=

# HMAC pepper for the email blind index. Changing it orphans all accounts.
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
BUDGET_BLIND_INDEX_PEPPER=

BUDGET_CIPHER=AES-256-GCM
BUDGET_NONCE_BYTES=12
BUDGET_TAG_BYTES=16
BUDGET_AAD_BIND_ROW=True
BUDGET_ENCRYPT_UPLOADS=True


# ============================================
# KEY ROTATION  (SEC-23/24)
# ============================================
# DEK rotation = new key + re-encrypt every row (the real revoke).
# See misc/FEATURES.md S17.
DEK_ROTATION_ENABLED=True
ROTATION_REVOKES_OTHER_SESSIONS=True


# ============================================
# Decrypted Working-Set Cache
# ============================================
CACHE_ENABLED=True
CACHE_TTL_SECONDS=900
CACHE_MAX_USERS=8
CACHE_MAX_ROWS_PER_USER=50000
CACHE_WARM_ON_LOGIN=True


# ============================================
# JWT Authentication
# ============================================
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=budget-app
JWT_AUDIENCE=budget-api
REFRESH_TOKEN_ROTATION=True
REFRESH_TOKEN_REUSE_REVOKES_FAMILY=True

# Scoped to this app: the host is shared with QUOT and other apps, so an
# unscoped cookie would be sent to all of them (ARCHITECTURE.md S10.3).
SESSION_COOKIE_NAME=zbdgt_session
SESSION_COOKIE_PATH=/ZBDGT
# False for local http://localhost only; web.config sets it true in production.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=lax
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=


# ============================================
# Password & Device Lock
# ============================================
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPER=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SYMBOL=True
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

PIN_ENABLED=True
PIN_LENGTH=6
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PIN_PEPPER=
PIN_MAX_ATTEMPTS=5
PIN_AUTO_LOCK_MINUTES=5
# SEC-12 - unlock the lock screen with Face ID / a fingerprint (a passkey). Needs
# HTTPS and APP_PUBLIC_URL set to the address people open - the passkey is bound to it.
BIOMETRIC_WEBAUTHN_ENABLED=False


# ============================================
# Password reset by email (SEC-30)
# ============================================
# The origin the emailed link points at - scheme and host only; BASE_URL
# is added. Never taken from the request. web.config sets production's.
APP_PUBLIC_URL=http://localhost:5173
PASSWORD_RESET_LINK_MINUTES=30
PASSWORD_RESET_WINDOW_MINUTES=60
PASSWORD_RESET_MAX_PER_EMAIL=3
PASSWORD_RESET_MAX_PER_IP=10


# ============================================
# Email (SMTP) - empty SMTP_HOST = no email, no reset by email
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# For Gmail, an App Password (Google account -> Security), not the login password.
SMTP_PASSWORD=
# Gmail rewrites From to the authenticated account: keep this = SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=Budget App
SMTP_USE_TLS=True


# ============================================
# Application Settings
# ============================================
APP_NAME=Budget App
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/ZBDGT/api/v1
BASE_URL=/ZBDGT
TZ=Asia/Manila

# MULTI-USER (SEC-17). Each user has their own data and own DEK.
# Registration is never open on a shared host - it is
# gated by REGISTRATION_CODE below, which you set and can rotate.
# NOTE: no admin can read another user's data - by construction.
SINGLE_USER_MODE=False
FIRST_USER_IS_ADMIN=True
MAX_USERS=5

# Signup gate (SEC-19). Anyone registering must supply this code.
# Change it to invalidate every outstanding invitation at once.
#   python -c "import secrets;print(secrets.token_urlsafe(18))"
REGISTRATION_MODE=code
REGISTRATION_CODE=
REGISTRATION_MAX_ATTEMPTS=5
REGISTRATION_ATTEMPT_WINDOW_MINUTES=60


# ============================================
# Budget Defaults
# ============================================
# SINGLE CURRENCY (ACC-11). Display/formatting only - there is no
# currency field on accounts or transactions and no FX conversion.
DEFAULT_CURRENCY=PHP
CURRENCY_SYMBOL=PHP
CURRENCY_DECIMALS=2
DEFAULT_LOCALE=en_PH
DEFAULT_BUDGET_PERIOD=monthly
DEFAULT_MONTH_START_DAY=1
DEFAULT_WEEK_START_DAY=1
DAILY_ALLOWANCE_MODE=remaining_over_days_left
# Carry-over (BUD-11) is a per-user Setting; this is only the
# initial default for a new account.
DEFAULT_CARRY_OVER_UNSPENT=False


# ============================================
# Budget Alerts  (in-app only - no web push)
# ============================================
ALERT_ENABLED=True
ALERT_WARN_THRESHOLD_PCT=80
ALERT_PACE_ENABLED=True
ALERT_PACE_TOLERANCE_PCT=10
ALERT_CATEGORY_LEVEL=True
CREDIT_DUE_ALERT_DAYS=5
# The posting window a NEW card starts with - each card can change its own (ACC-26)
CARD_POSTING_LAG_DAYS=3


# ============================================
# Frontend
# ============================================
FRONTEND_DIST_DIR=./app/web/static/dist
FRONTEND_DEV_SERVER=http://localhost:5173
VITE_PROXY_ENABLED=True
SPA_FALLBACK=True
PWA_ENABLED=True


# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000


# ============================================
# Uploads
# ============================================
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.heic,.pdf,.csv
UPLOAD_DIR=./uploads
TEMP_DIR=./temp_uploads


# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300


# ============================================
# Backup  (encrypted .budgetbak - see ARCHITECTURE.md S12)
# ============================================
# Encrypted end to end, so it is safe on a USB stick or in cloud
# storage - ON ITS OWN. Carries the DEK wrapped under the master key,
# so a backup plus this file opens everything: keep them apart.
# There is deliberately NO plaintext full archive.
BACKUP_ENABLED=True
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=90
BACKUP_FORMAT=budgetbak
BACKUP_INCLUDE_ATTACHMENTS=True
# Triggered by use, never a clock - IIS idle-stops the app (web.config).
BACKUP_TRIGGER=activity
BACKUP_DEBOUNCE_MINUTES=5
BACKUP_INTERVAL_HOURS=24
# Second destination - synced folder, mapped drive, USB path.
# EMPTY FOR NOW. Backups then live only on the app server (a different
# machine from the database). Until you set a second location, use
# 'Back up now' -> download in Settings to keep a copy on your own
# device now and then; the file is encrypted, so that is safe.
BACKUP_OFFSITE_DIR=
BACKUP_VERIFY_ON_WRITE=True
