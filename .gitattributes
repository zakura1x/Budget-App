# Normalise source files; let each machine choose its checkout line endings.
* text=auto

# The committed frontend build is served byte-for-byte by FastAPI on the
# server. Git must never rewrite its line endings (misc/ARCHITECTURE.md S7).
app/web/static/dist/** -text

*.png binary
*.ico binary
*.woff2 binary

# Notes for Claude Code while developing - not part of a release (scripts/make_release.py
# uses git archive, which leaves out export-ignore paths).
CLAUDE.md export-ignore

# Screenshots of each phase's changes (made-up local data): kept in the repository and
# on GitHub, but the server has no use for them, so they stay out of the release zip.
misc/archive/screenshots/** export-ignore
